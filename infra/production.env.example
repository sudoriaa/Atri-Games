# Copy this file to the repository root as .env, replace the secrets, then run:
# docker compose up --detach --build
#
# A public DNS hostname enables Caddy-managed HTTPS automatically.
# For a loopback-only smoke test, use ATRI_SITE_ADDRESS=http://:8080.
ATRI_SITE_ADDRESS=games.example.com
ATRI_HTTP_PORT=80
ATRI_HTTPS_PORT=443
ATRI_CORS_ORIGINS=null

# Replace both values before the first start. Keep them stable across restarts.
ATRI_JWT_SECRET=replace-with-at-least-32-random-characters
ATRI_ADMIN_EMAIL=admin@atri.games
ATRI_ADMIN_PASSWORD=replace-with-a-long-unique-password

ATRI_LOG_LEVEL=info
ATRI_IMAGE_TAG=local
ATRI_GO_MAX_PROCS=2
ATRI_GO_MEMORY_LIMIT=256MiB
ATRI_GAME_COVER_MAX_BYTES=10485760
ATRI_GAME_COVER_MAX_SIZE=12MB
ATRI_GAME_PACKAGE_MAX_BYTES=536870912
ATRI_GAME_PACKAGE_MAX_UNPACKED_BYTES=2147483648
ATRI_GAME_PACKAGE_MAX_FILES=20000
ATRI_GAME_PACKAGE_MAX_SIZE=513MB
# Base64-encoded PEM private key. Keep it private and pair it with the public
# key given to the game-kit pack command for this deployment.
ATRI_PACKAGE_DECRYPTION_PRIVATE_KEY_BASE64=replace-with-base64-pem-private-key
ATRI_GAME_TICKET_TTL_SECONDS=900

# MinIO mirrors managed covers, demos and .atri static builds. It remains on
# the private Docker network; set long unique credentials before first start.
ATRI_OBJECT_STORAGE_PROVIDER=minio
ATRI_OBJECT_STORAGE_ENDPOINT=minio:9000
ATRI_OBJECT_STORAGE_BUCKET=atri-games
ATRI_OBJECT_STORAGE_PREFIX=assets
ATRI_OBJECT_STORAGE_USE_SSL=false
ATRI_OBJECT_STORAGE_REGION=us-east-1
ATRI_OBJECT_STORAGE_SYNC_TIMEOUT_SECONDS=600
ATRI_MINIO_ROOT_USER=atri-minio
ATRI_MINIO_ROOT_PASSWORD=replace-with-a-long-unique-minio-password
ATRI_MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
ATRI_MINIO_DATA_VOLUME=atri-games-minio-data

# Optional image build overrides.
NODE_VERSION=22.14.0
GO_VERSION=1.26.5
ALPINE_VERSION=3.22
CADDY_VERSION=2.10.2

# Named volumes are deliberately stable across Compose project names.
ATRI_DATA_VOLUME=atri-games-data
ATRI_ASSET_VOLUME=atri-games-assets
ATRI_CADDY_DATA_VOLUME=atri-games-caddy-data
ATRI_CADDY_CONFIG_VOLUME=atri-games-caddy-config
