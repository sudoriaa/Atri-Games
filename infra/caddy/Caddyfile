{
	http_port 8080
	https_port 8443
	admin 127.0.0.1:2019
}

{$ATRI_SITE_ADDRESS:http://:8080} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	@portalHeaders {
		not path_regexp gameResponse ^/games/[a-z0-9]+(?:-[a-z0-9]+)*/play(?:/.*)?$
	}
	header @portalHeaders {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob: https:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
	}

	@api path /api /api/*
	@gameImport path /api/v1/admin/games/import
	handle @gameImport {
		request_body {
			max_size {$ATRI_GAME_PACKAGE_MAX_SIZE:513MB}
		}

		reverse_proxy api:8080 {
			lb_try_duration 5s
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 3s

			transport http {
				dial_timeout 3s
				response_header_timeout 10m
			}
		}
	}

	@gameCoverMutation {
		path /api/v1/admin/games /api/v1/admin/games/*
		header Content-Type multipart/form-data*
	}
	handle @gameCoverMutation {
		request_body {
			max_size {$ATRI_GAME_COVER_MAX_SIZE:12MB}
		}

		reverse_proxy api:8080 {
			lb_try_duration 5s
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 3s

			transport http {
				dial_timeout 3s
				response_header_timeout 35s
			}
		}
	}

	@avatarUpload {
		path /api/v1/me/avatar
		header Content-Type multipart/form-data*
	}
	handle @avatarUpload {
		request_body {
			max_size {$ATRI_AVATAR_MAX_SIZE:3MB}
		}

		reverse_proxy api:8080 {
			lb_try_duration 5s
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 3s

			transport http {
				dial_timeout 3s
				response_header_timeout 35s
			}
		}
	}

	handle @api {
		request_body {
			max_size 2MB
		}

		reverse_proxy api:8080 {
			lb_try_duration 5s
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 3s

			transport http {
				dial_timeout 3s
				response_header_timeout 35s
			}
		}
	}

	# Static game packages live on the main host but execute in a CSP sandbox
	# without allow-same-origin. The browser therefore gives their scripts an
	# opaque origin: they cannot read portal localStorage or cookies, while
	# relative assets and game-ticket API requests remain available.
	@gamePlayCanonical path_regexp gamePlayCanonical ^/games/([a-z0-9]+(?:-[a-z0-9]+)*)/play$
	redir @gamePlayCanonical /games/{re.gamePlayCanonical.1}/play/ 308

	@gamePlayRoot path_regexp gamePlayRoot ^/games/([a-z0-9]+(?:-[a-z0-9]+)*)/play/$
	handle @gamePlayRoot {
		root * /assets
		rewrite * /playables/{re.gamePlayRoot.1}/index.html
		header {
			Access-Control-Allow-Origin "*"
			Cache-Control "no-cache"
			Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-pointer-lock allow-popups allow-downloads allow-top-navigation-by-user-activation; default-src * data: blob:; base-uri 'none'; connect-src * data: blob:; font-src * data:; form-action *; frame-src *; img-src * data: blob:; media-src * data: blob:; object-src 'none'; script-src * 'unsafe-inline' 'unsafe-eval' blob:; style-src * 'unsafe-inline'; worker-src * data: blob:"
			Cross-Origin-Opener-Policy "unsafe-none"
			Cross-Origin-Resource-Policy "cross-origin"
			Referrer-Policy "no-referrer"
		}
		file_server
	}

	@gamePlayAsset path_regexp gamePlayAsset ^/games/([a-z0-9]+(?:-[a-z0-9]+)*)/play/(.+)$
	handle @gamePlayAsset {
		root * /assets
		rewrite * /playables/{re.gamePlayAsset.1}/{re.gamePlayAsset.2}

		@wasmBrotli path *.wasm.br
		header @wasmBrotli Content-Type "application/wasm"
		@wasmGzip path *.wasm.gz
		header @wasmGzip Content-Type "application/wasm"
		@javascriptBrotli path *.js.br
		header @javascriptBrotli Content-Type "text/javascript; charset=utf-8"
		@javascriptGzip path *.js.gz
		header @javascriptGzip Content-Type "text/javascript; charset=utf-8"
		@dataBrotli path *.data.br
		header @dataBrotli Content-Type "application/octet-stream"
		@dataGzip path *.data.gz
		header @dataGzip Content-Type "application/octet-stream"
		@brotliAsset path *.br
		header @brotliAsset Content-Encoding "br"
		@gzipAsset path *.gz
		header @gzipAsset Content-Encoding "gzip"

		header {
			Access-Control-Allow-Origin "*"
			Cache-Control "no-cache"
			Content-Security-Policy "sandbox allow-scripts allow-forms allow-modals allow-pointer-lock allow-popups allow-downloads allow-top-navigation-by-user-activation; default-src * data: blob:; base-uri 'none'; connect-src * data: blob:; font-src * data:; form-action *; frame-src *; img-src * data: blob:; media-src * data: blob:; object-src 'none'; script-src * 'unsafe-inline' 'unsafe-eval' blob:; style-src * 'unsafe-inline'; worker-src * data: blob:"
			Cross-Origin-Opener-Policy "unsafe-none"
			Cross-Origin-Resource-Policy "cross-origin"
			Referrer-Policy "no-referrer"
		}
		try_files {path} /playables/{re.gamePlayAsset.1}/index.html
		file_server
	}

	# Preserve old bookmarks without retaining the obsolete 8081 Game Origin.
	@legacyPlayableRoot path_regexp legacyPlayableRoot ^/playables/([a-z0-9]+(?:-[a-z0-9]+)*)(?:/index\.html)?/?$
	redir @legacyPlayableRoot /games/{re.legacyPlayableRoot.1}/play/ 308
	@legacyPlayableAsset path_regexp legacyPlayableAsset ^/playables/([a-z0-9]+(?:-[a-z0-9]+)*)/(.+)$
	redir @legacyPlayableAsset /games/{re.legacyPlayableAsset.1}/play/{re.legacyPlayableAsset.2} 308

	@managedAssets path /avatars /avatars/* /covers /covers/* /demos /demos/*
	handle @managedAssets {
		root * /assets
		header Cache-Control "no-cache"
		file_server
	}

	@sdk path /sdk/atri-game-sdk.js
	handle @sdk {
		root * /srv/web
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
		file_server
	}

	@runtimeBootstrap path /sdk/atri-game-runtime-bootstrap.js
	handle @runtimeBootstrap {
		root * /srv/web
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=300"
		file_server
	}

	@adminRoot path /admin
	redir @adminRoot /admin/ 308

	handle_path /admin/* {
		root * /srv/admin

		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	handle {
		root * /srv/web

		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
