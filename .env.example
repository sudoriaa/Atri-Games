ATRI_ADDR=:8080
ATRI_ASSET_ROOT=../../apps/web/public
ATRI_GAME_COVER_MAX_BYTES=10485760
ATRI_GAME_PACKAGE_MAX_BYTES=536870912
ATRI_GAME_PACKAGE_MAX_UNPACKED_BYTES=2147483648
ATRI_GAME_PACKAGE_MAX_FILES=20000
# Base64-encoded PEM private key used to decrypt ATRIENC1 packages. Leave
# empty only when this development API should accept legacy plain ZIP packages.
ATRI_PACKAGE_DECRYPTION_PRIVATE_KEY_BASE64=
ATRI_GAME_TICKET_TTL_SECONDS=900
ATRI_DB_PATH=./data/atri-games.db
ATRI_JWT_SECRET=replace-with-at-least-32-random-characters
ATRI_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,null
ATRI_ADMIN_EMAIL=admin@atri.games
ATRI_ADMIN_PASSWORD=AtriAdmin123!
ATRI_OBJECT_STORAGE_PROVIDER=local
ATRI_OBJECT_STORAGE_ENDPOINT=
ATRI_OBJECT_STORAGE_ACCESS_KEY=
ATRI_OBJECT_STORAGE_SECRET_KEY=
ATRI_OBJECT_STORAGE_BUCKET=atri-games
ATRI_OBJECT_STORAGE_PREFIX=assets
ATRI_OBJECT_STORAGE_USE_SSL=false
ATRI_OBJECT_STORAGE_REGION=us-east-1
ATRI_OBJECT_STORAGE_SYNC_TIMEOUT_SECONDS=600
VITE_API_URL=/api/v1
